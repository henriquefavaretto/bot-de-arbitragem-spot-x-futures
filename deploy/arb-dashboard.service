[Unit]
Description=MEXC Arbitrage Dashboard + Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/arb/backend
EnvironmentFile=/home/ubuntu/arb/backend/.env

# --host 127.0.0.1 e a decisao de seguranca mais importante deste arquivo.
#
# A API NAO TEM AUTENTICACAO NENHUMA e expoe endpoints que movem dinheiro
# (habilitar par para operar, kill switch) e que leem saldo. Escutar em
# 0.0.0.0 colocaria isso na internet aberta: qualquer um que escaneie o IP da
# VPS poderia ligar pares e ver os saldos.
#
# Escutando so no loopback, o unico caminho de acesso e o tunel SSH, que ja
# exige a sua chave privada. Se um dia a API ganhar autenticacao de verdade,
# este e o lugar de reavaliar.
ExecStart=/home/ubuntu/arb/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=10
# O bot precisa sobreviver a reinicio: posicoes abertas nao esperam.
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=arb-dashboard

[Install]
WantedBy=multi-user.target
